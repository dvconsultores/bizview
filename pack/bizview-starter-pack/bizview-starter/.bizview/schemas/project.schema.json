{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bizview project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Nombre del proyecto en Bizview."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,49}$",
      "description": "Identificador corto del proyecto en minúsculas, números y guiones; igual al nombre de su carpeta."
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Descripción breve del proyecto."
    },
    "locale": {
      "enum": [
        "es",
        "en"
      ],
      "description": "Idioma de las especificaciones del proyecto."
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Fecha de creación del proyecto en formato ISO 8601."
    }
  }
}
