.env
.venv/
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
test-results/
playwright-report/
.specify/integrations/.cache/
/workspace/
/projects/
/attachments/
/image-cache/

# Secret-bearing local config must never reach a public repository.
.env.bak*
.env.local
.env.*.local

# Local test/build scratch and any stray secrets must never be published.
*.log
.pytest-*
*.tsbuildinfo
*.pem
*.key
*.p12
# Certificate pairs supplied with CADDY_TLS=file (never published).
deploy/caddy/certs/*
!deploy/caddy/certs/.gitkeep
*.sqlite
*.dump

# Scratch output from local test runs (never part of the product).
.*-out.txt
.dod-*

# A project downloaded with the workspace's Download button (kept out of the repo).
/artemisa/
tmp/
