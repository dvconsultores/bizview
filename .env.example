# Bizview AI Powered — settings TEMPLATE. Copy it to `.env` next to bizview.yml and fill it in.
# `.env` holds the real values and is git-ignored; never commit it. This file must stay free of
# secrets so it can be published.

# ---- Database: the product's own data (users, access, audit, workspace versions, datasets) ----
DATABASE_URL_BI=
# ---- Super user (created on first start only; recovery: see docs/INSTALL.md) ----
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# ---- Branding ----
PRODUCT_NAME=Bizview AI Powered
ORGANIZATION_NAME=
# Empty uses the logo inside the bizview-web image (/branding/logo.svg).
LOGO_URL=

# ---- Address and edge ----
# A domain enables automatic HTTPS and is the address used by shared-dashboard links and emails;
# ":80" is for plain HTTP or for a proxy in front that terminates TLS.
SITE_ADDRESS=
# Host names Caddy serves; any other Host is refused with 421. Must include SITE_ADDRESS.
CADDY_ALLOWED_HOSTS=
# Published HOST ports: the only ones that can collide with another stack (Caddy always listens
# on 80 and 443 inside).
HTTP_PORT=8090
HTTPS_PORT=9443
# Certificate source: auto (ACME, needs host 443 or 80) | internal (Caddy's CA, for a proxy that
# does not verify it, e.g. Cloudflare "Full") | file (a pair in CADDY_TLS_DIR).
CADDY_TLS=internal
# true whenever users reach the site over HTTPS.
COOKIE_SECURE=true
# Who may set X-Forwarded-For. Set it to whatever connects to Caddy (the proxy's network, or
# Cloudflare's ranges) or every visitor shares one address. Default: loopback only.
# TRUSTED_PROXIES=172.16.0.0/12

# ---- Security (feature 004) ----
# private = HTTP allowed (local) | internet = HTTPS required everywhere, two-step sign-in for
# administrators (an internet installation refuses to start without a domain and COOKIE_SECURE).
SECURITY_PROFILE=private
# ADMIN_ALLOWED_NETWORKS=
# SOURCES_ALLOW_PRIVATE_NETWORKS=true
# Encrypts stored credentials. BACK IT UP (password manager); losing it means re-entering
# data-source credentials and two-step sign-in.
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BIZVIEW_SECRET_KEY=
# BIZVIEW_SECRET_KEY_PREVIOUS=          # only while rotating the key

# ---- AI (optional, off by default) ----
# none | anthropic (AI_API_KEY) | openai_compatible (AI_BASE_URL + AI_MODEL, e.g. a local model)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=120

# ---- Backend ----
DOCS_ENABLED=false
LOG_LEVEL=INFO

# ---- Vibe reporting (feature 005) ----
TIMEZONE=America/Caracas

# ---- Database pool (optional; uncomment to enlarge it) ----
# DB_POOL_SIZE=12
# DB_POOL_OVERFLOW=8
# DB_POOL_WARM=8

# ---- Email (optional; off until SMTP_HOST and SMTP_FROM are set) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# starttls | ssl (required by the internet profile)
# SMTP_SECURITY=ssl
# EMAIL_ALLOWED_DOMAINS=

SHARE_LINKS_ENABLED=false

# ---- Sign in with Google (optional, off by default; feature 027) ----
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
# GOOGLE_REDIRECT_URI=          # only for unusual proxy setups; empty derives it from SITE_ADDRESS

# ---- Direct reports (feature 019) ----
# Reading tables of the product's own database requires DIRECT_BI_ROLE on the internet profile;
# report from a data source or an integration instead (see docs/INSTALL.md section 5).
DIRECT_REPORTS_BI=false

# ---- Docker Hub (read only by deploy.sh, on the machine that publishes images) ----
# The password goes to `docker login` on stdin. Leave both empty on a server that only pulls.
DOCKER_USERNAME=
DOCKER_PASSWORD=


AI_CHAT_TOKEN_BUDGET=800000    # where each conversation starts
AI_CHAT_BUDGET_STEP=250000     # each "Ampliar"
AI_CHAT_BUDGET_MAX=5000000     # hard ceiling the server accepts (max 5 000 000)
AI_COMMAND_TOKEN_CEILING=400000  # hard ceiling of one /speckit-… command run
AI_CONTEXT_COMPACT_CHARS=200000  # in-turn history budget; past it the loop compacts once
AI_STAGE_TOKEN_BUDGET=600000     # ceiling of one stage of /speckit-all (blocked:stage_budget)
