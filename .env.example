# Bizview AI Powered — settings TEMPLATE. Copy it to `.env` next to bizview.yml and fill it in.
# `.env` holds the real values and is git-ignored; never commit it. This file must stay free of
# secrets so it can be published.

# ---- Database: the product's own data (users, access, audit, workspace versions, datasets) ----
DATABASE_URL_BI=
# ---- Super user (created on first start only; recovery: see docs/INSTALL.md) ----
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# ---- Branding ----
# The product's own name; set your own to rebrand the installation.
PRODUCT_NAME=Bizview
ORGANIZATION_NAME=
# Empty uses the logo inside the bizview-web image (/branding/logo.svg).
LOGO_URL=

# ---- Address and edge ----
# A domain enables automatic HTTPS and is the address used by shared-dashboard links and emails;
# ":80" is for plain HTTP or for a proxy in front that terminates TLS.
SITE_ADDRESS=
# Host names Caddy serves; any other Host is refused with 421. Must include SITE_ADDRESS.
CADDY_ALLOWED_HOSTS=
# Published HOST ports: the only ones that can collide with another stack (Caddy always listens
# on 80 and 443 inside).
HTTP_PORT=8090
HTTPS_PORT=9443
# Certificate source: auto (ACME, needs host 443 or 80) | internal (Caddy's CA, for a proxy that
# does not verify it, e.g. Cloudflare "Full") | file (a pair in CADDY_TLS_DIR).
CADDY_TLS=internal
# true whenever users reach the site over HTTPS.
COOKIE_SECURE=true
# Who may set X-Forwarded-For. Set it to whatever connects to Caddy (the proxy's network, or
# Cloudflare's ranges) or every visitor shares one address. Default: loopback only.
# TRUSTED_PROXIES=172.16.0.0/12

# ---- Security (feature 004) ----
# private = HTTP allowed (local) | internet = HTTPS required everywhere, two-step sign-in for
# administrators (an internet installation refuses to start without a domain and COOKIE_SECURE).
SECURITY_PROFILE=private
# ADMIN_ALLOWED_NETWORKS=
# SOURCES_ALLOW_PRIVATE_NETWORKS=true
# Encrypts stored credentials. BACK IT UP (password manager); losing it means re-entering
# data-source credentials and two-step sign-in.
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BIZVIEW_SECRET_KEY=
# BIZVIEW_SECRET_KEY_PREVIOUS=          # only while rotating the key

# ---- AI (optional, off by default; help and the structure chat, 052) ----
# none | anthropic (AI_API_KEY) | openai_compatible (AI_BASE_URL + AI_MODEL, e.g. a local model)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=120
# "Generar estructura con IA" (Fuentes de datos → Estructura): token ceiling for ONE run (0 turns
# the button off). Past it the run stops chunking and says what it did not examine.
AI_STRUCTURE_TOKENS=150000

# ---- Backend ----
DOCS_ENABLED=false
LOG_LEVEL=INFO

# ---- Vibe reporting (feature 005) ----
TIMEZONE=America/Caracas

# ---- Images (feature 044) ----
# Where the worker stores the pictures a report reads from a URL column; they are named by their
# content hash and shared by every project. Days a cached image is kept before the sweep drops it.
IMAGE_CACHE_DIR_HOST=./image-cache
IMAGE_CACHE_DAYS=90

# ---- Database pool (optional; uncomment to enlarge it) ----
# DB_POOL_SIZE=12
# DB_POOL_OVERFLOW=8
# DB_POOL_WARM=8

# ---- Email (optional; off until SMTP_HOST and SMTP_FROM are set) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# starttls | ssl (required by the internet profile)
# SMTP_SECURITY=ssl

# ---- Sending (feature 058) ----
# An optional restriction. Empty (the default) accepts any domain; a comma-separated list limits
# the free addresses a sender types and the members of a mailing list, never the installation's
# own users.
# EMAIL_ALLOWED_DOMAINS=
# Recipients per SMTP message (BCC, the sender in To). A 1.500-person send is 30 messages at 50.
# EMAIL_BATCH_SIZE=50
# Messages per second, so a big list neither stalls the worker nor trips the provider. 0 = no pause.
# EMAIL_SEND_RATE=10
# One message per address instead of BCC batches: what Amazon SES recommends for per-address
# bounce handling.
# EMAIL_INDIVIDUAL_MESSAGES=false
# Hold the queue (sends keep being accepted) while the provider problem is solved.
# EMAIL_SENDING_PAUSED=false
# Who the mail says it comes from: `installation` sends from SMTP_FROM with the sender as Reply-To;
# `user` sends From the sender's own address through the same relay (a corporate "send as" account).
# EMAIL_FROM_MODE=installation
# `admin` restricts free addresses to administrators; lists and installation users are unaffected.
# EMAIL_FREE_ADDRESSES_ROLE=user

SHARE_LINKS_ENABLED=false

# ---- Sign in with Google (optional, off by default; features 027 and 054) ----
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAINS is the *initial* value only: the first save of Administración → Seguridad →
# Ingreso con Google stores the list in the database, and from then on the settings win.
GOOGLE_ALLOWED_DOMAINS=
# GOOGLE_REDIRECT_URI=          # only for unusual proxy setups; empty derives it from SITE_ADDRESS

# ---- Direct reports (feature 019) ----
# Reading tables of the product's own database requires DIRECT_BI_ROLE on the internet profile;
# report from a data source or an integration instead (see docs/INSTALL.md section 5).
DIRECT_REPORTS_BI=false

# ---- Origin connection slots (feature 060) ----
# When an origin answers "too many clients" (SQLSTATE 53300) the run waits and tries again instead
# of failing: SOURCE_CONNECT_RETRIES is the total number of attempts (1 = no retry) and
# SOURCE_CONNECT_BACKOFF_S the base of the exponential wait — 15 s gives 15 s, 45 s, 2 min, 5 min.
# How many simultaneous connections BizView may open on one source is set per source, on the source
# page ("Conexiones simultáneas"; default 1 for PostgreSQL, 2 for Supabase).
# SOURCE_CONNECT_RETRIES=4
# SOURCE_CONNECT_BACKOFF_S=15

# ---- Docker Hub (read only by deploy.sh, on the machine that publishes images) ----
# The password goes to `docker login` on stdin. Leave both empty on a server that only pulls.
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Origin checks run inside this window (SQL/HTTP), on the explicit validate action only.
ORIGIN_CHECK_TIMEOUT_SECONDS=20
