# ---- Images (what the stack runs) ----
# Namespace and tag of the two published images: <BIZVIEW_IMAGE_PREFIX>/bizview-backend and
# <BIZVIEW_IMAGE_PREFIX>/bizview-web. `deploy.sh` pushes them to the Docker Hub user in
# DOCKER_USERNAME, so set this to that same user on a server that pulls; a developer running
# `docker compose -f bizview.yml up -d --build` only tags the local build with these names.
BIZVIEW_IMAGE_PREFIX=your-dockerhub-user
BIZVIEW_VERSION=latest
# The compose file of this installation; lets `docker compose up -d` work without -f.
COMPOSE_FILE=bizview.yml

# ---- Database (always external; tables in the standard schema "public") ----
DATABASE_URL_BI=postgresql://dash_api:change-me@db-host:5432/bi

# ---- Super user (created on first start only; see docs/INSTALL.md, "Recover the super user") ----
SUPER_USER_EMAIL=admin@example.com
SUPER_USER_PASSWORD=change-me-min-10-chars

# ---- Branding (per customer deployment) ----
PRODUCT_NAME=Bizview AI Powered
ORGANIZATION_NAME=
# Path served by Caddy from deploy/branding (or a mounted folder), e.g. /branding/logo.svg
LOGO_URL=

# ---- Edge / public address ----
# The public domain of this installation (e.g. bi.example.com): Caddy obtains and renews the
# certificate automatically, and the domain is also the address of shared-dashboard links and of
# links in emails (feature 018). Use ":80" only for local HTTP or behind another TLS terminator.
SITE_ADDRESS=bi.example.com
# Space-separated list of Host names Caddy serves; any other Host is refused with 421 before it
# reaches the app. It must include the domain in SITE_ADDRESS (add more names only if this
# installation is reached through aliases).
CADDY_ALLOWED_HOSTS=bi.example.com
# Largest request body Caddy accepts (default 100MB). It must fit the biggest upload: image
# briefs (ATTACHMENTS_MAX_MB × ATTACHMENTS_MAX_PER_MESSAGE, 4 × 20 MB by default) and project
# zip imports (PROJECT_MAX_MB, 20 MB by default). The compose file passes it to the caddy
# container.
# CADDY_MAX_REQUEST_BODY=100MB
# Published HOST ports. Only these can collide with another stack: the containers always listen
# on 80 and 443 inside, so publishing 8443 neither binds nor needs host 443.
# These defaults are the safe ones for a shared host. Use the standard ports only when they are
# free here: HTTPS_PORT=443 then lets automatic HTTPS answer the TLS-ALPN challenge (HTTP_PORT=80
# answers HTTP-01) and keeps the URL free of a port suffix.
# Note: shared-dashboard and email links use SITE_ADDRESS without a port, so a non-standard
# HTTPS_PORT needs something in front that answers 443 for the domain (a reverse proxy or CDN).
HTTP_PORT=8081
HTTPS_PORT=8443
# How Caddy obtains its certificate:
#   auto     automatic HTTPS (default). Requires host 443 or host 80 to reach this container.
#   internal Caddy's local CA. For a proxy in front that does not verify the origin certificate:
#            Cloudflare with SSL mode "Full" (not "Full (strict)"), and an Origin Rule that sends
#            the hostname to this container's port (e.g. 8443; Cloudflare accepts 8443, 2053,
#            2083, 2087, 2096 as HTTPS origin ports).
#   file     a certificate you supply, e.g. a Cloudflare Origin CA pair, in CADDY_TLS_DIR
#            (default ./deploy/caddy/certs) as origin.pem + origin-key.pem. Required for
#            Cloudflare "Full (strict)"; no host port is needed for issuance.
# CADDY_TLS=auto
# CADDY_TLS_DIR=./deploy/caddy/certs
# CADDY_TLS_CERT=/certs/origin.pem
# CADDY_TLS_KEY=/certs/origin-key.pem
# true whenever the site is reachable over HTTPS; false only for local HTTP
COOKIE_SECURE=true

# ---- Security (feature 004) ----
# private (HTTP allowed) | internet (HTTPS required, two-step sign-in for admins) | auto
# Use "internet" for any installation reachable from the internet.
SECURITY_PROFILE=internet
# Encrypts stored credentials (base64url of 32 bytes). Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Back it up separately from database backups.
BIZVIEW_SECRET_KEY=
# BIZVIEW_SECRET_KEY_PREVIOUS=          # only while rotating the key
# ADMIN_ALLOWED_NETWORKS=10.0.0.0/8     # administration only from these networks
# SOURCES_ALLOW_PRIVATE_NETWORKS=true
# LOGIN_RATE_LIMIT=20
# LOGIN_RATE_WINDOW_MINUTES=15
# TRUSTED_PROXIES=10.0.0.0/8            # load balancer in front of Caddy (default: none)

# ---- Sign in with Google (optional, off by default; feature 027) ----
# Adds a "Continuar con Google" button next to the password form. It never creates accounts: a
# Google sign-in succeeds only when the verified email belongs to an existing, active user, so
# invite the person first. Password sign-in keeps working, and administrators on the "internet"
# profile still enter their second factor. The flow needs outbound HTTPS to Google.
GOOGLE_AUTH_ENABLED=false
# Client id and secret of THIS installation's OAuth client, created in the customer's own Google
# Cloud project (never a client held by the vendor). The authorised redirect URI in that client
# must be exactly https://<your-domain>/api/auth/google/callback, with the domain of SITE_ADDRESS.
GOOGLE_CLIENT_ID=
# Secret: read only by the backend, never returned by the API, logged or shown in the interface.
GOOGLE_CLIENT_SECRET=
# Optional: comma-separated email domains allowed to sign in (empty = any domain).
# GOOGLE_ALLOWED_DOMAINS=cliente.com,socio.com
# Optional: override the redirect URI, only for unusual proxy setups. Empty derives it from
# SITE_ADDRESS.
# GOOGLE_REDIRECT_URI=

# ---- Vibe reporting (feature 005) ----
# Time zone of schedules and report periods (IANA name).
TIMEZONE=UTC
# Optional: a customer Git workspace checkout (`bizview init`), only for installations that keep
# one. The shipped bizview.yml neither mounts nor sets it: reports and integrations come from BI
# projects, applied in the app (feature 020). To use a checkout instead, add
# `${WORKSPACE_DIR:-./workspace}:/workspace:ro` to the backend and worker services and set
# WORKSPACE_PATH=/workspace for both. `starter.py` reads WORKSPACE_PATH in development.
# WORKSPACE_PATH=../my-customer-bizview
# WORKSPACE_DIR=../my-customer-bizview

# BI projects (feature 020): one folder per project, written only by the backend.
# PROJECTS_DIR is the path inside the backend (docker compose mounts PROJECTS_DIR_HOST there).
# PROJECTS_DIR=/app/data/projects
# PROJECTS_DIR_HOST=./projects
# Maximum size of one project folder in MB (1-500).
PROJECT_MAX_MB=20

# Image briefs of the chat (feature 024): the uploaded images live here, outside the project
# folders. ATTACHMENTS_DIR is the path inside the backend (docker compose mounts
# ATTACHMENTS_DIR_HOST there). Include this folder in the backups of the installation.
# ATTACHMENTS_DIR=/app/data/attachments
# ATTACHMENTS_DIR_HOST=./attachments

# Who publishes the installation: shown after the license in every screen's footer.
# FOOTER_CREDIT=GlobalDV

# ---- AI (optional, off by default) ----
# none | anthropic | openai_compatible
AI_PROVIDER=none
# anthropic: key required; model defaults to claude-opus-5-5
# openai_compatible (OpenAI, Ollama, vLLM, LM Studio...): AI_BASE_URL and AI_MODEL required
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
# Feature 014: token budget per assistant conversation (Administración → Asistente)
AI_CHAT_TOKEN_BUDGET=400000
# Share of a cached prompt token counted against the budget (DeepSeek bills cache hits ~10%)
# AI_CHAT_CACHED_TOKEN_WEIGHT=0.1
# Feature 017: assistant agent limits (defaults shown)
# AI_CHAT_MAX_ROUNDS=60      # tool rounds per autonomous run, 1–200; then a progress message
# AI_CHAT_MAX_TOKENS=16000   # longest answer per round (a full draft needs several thousand), 1024–64000
# AI_CHAT_BUDGET_STEP=100000 # tokens added automatically during a run or by "Ampliar presupuesto"
# AI_CHAT_BUDGET_MAX=2000000 # ceiling for budget extensions; the only limit that stops a run
# AI_AGENT_MAX_CONCURRENT=4  # assistant runs working at once, 1–32; more get 409
# AI_CHAT_MAX_PREVIEWS=5     # agent previews per conversation, 1–20
# AI_TOOL_TIMEOUT_SECONDS=20 # per profile_source/check_query call, 1–120
# AI_CHAT_TIMEOUT_SECONDS=180 # per assistant chat call, 10–600 (other AI calls: AI_TIMEOUT_SECONDS)
# AI_AGENT_DISCOVERY_LIMIT=15 # discovery calls per run without a draft, then draft tools only, 3–100
# AI_CHAT_BUSY_STALE_SECONDS=900 # busy mark older than this = interrupted turn, 60–7200;
#   must exceed 2 x AI_CHAT_TIMEOUT_SECONDS + AI_TOOL_TIMEOUT_SECONDS
# Feature 024: an image attached to a chat message as the report brief
# AI_VISION=auto            # auto (true for the anthropic provider, false for openai_compatible),
#                           # true, or false to refuse images with a clear message
# ATTACHMENTS_DIR=attachments # where the uploaded images live; include it in backups
# ATTACHMENTS_MAX_MB=5      # per image, 1–20
# ATTACHMENTS_MAX_PER_MESSAGE=4 # images waiting to be sent in one conversation, 1–10
# The workspace manifest created by the assistant on an installation without a version
# takes its name from ORGANIZATION_NAME (as a slug).

# ---- Email and shared links (optional, off by default; feature 018) ----
# Email is on when SMTP_HOST and SMTP_FROM are set. The worker sends the mail.
SMTP_HOST=
# 587 (STARTTLS) by default; 465 means SSL/TLS
SMTP_PORT=587
# starttls | ssl | none (none is refused on the internet profile); empty = by port
SMTP_SECURITY=
SMTP_USER=
# Secret: never shown or logged. ASCII only.
SMTP_PASSWORD=
# Sender address and display name (name defaults to ORGANIZATION_NAME)
SMTP_FROM=
SMTP_FROM_NAME=
# External recipient domains, comma-separated (empty = installation users only)
EMAIL_ALLOWED_DOMAINS=
# Read-only dashboard links that expire after 1-90 days ("Compartir")
SHARE_LINKS_ENABLED=false

# ---- Direct reports (feature 019): reports that read a source without an integration ----
# DIRECT_REPORTS_BI=true                   # reports may read tables of the BI database directly
# DIRECT_REPORT_CONCURRENCY=2              # at most this many direct queries at once per source (1-20)
# DIRECT_REPORT_WARN_ROWS=5000000          # above this estimated row count a direct table needs an index on its date column; the agent warns

# ---- Language (feature 022): es or en; used when neither the account nor the browser decides ----
# DEFAULT_LOCALE=es
# DIRECT_BI_ROLE=bizview_direct            # read-only database role for defence in depth (required on the internet profile; see docs/INSTALL.md)

# ---- Integration transforms (feature 005, Polars) ----
# TRANSFORM_MAX_ROWS=50000000              # safety stop on the input rows of a whole-mode transform
# TRANSFORM_SPILL_DIR=/tmp/bizview-transform  # folder for whole-mode spill files (default: system temp folder)
# POLARS_TEMP_DIR=/tmp/bizview-polars       # Polars streaming-engine spill folder for whole-mode transforms; the disk must hold about the size of the window
# ROLLUP_TIMEOUT_SECONDS=1800            # time limit of a daily-rollup build done by the worker outside a run

# ---- Source code link shown to users (AGPL-3.0); release images set it automatically ----
# SOURCE_URL=https://github.com/<owner>/bizview

# ---- Backend ----
DOCS_ENABLED=false
LOG_LEVEL=INFO
# Optional tuning (defaults shown). Connections kept open to the BI database: a new one costs
# ~1.4 s against a remote server, so enough stay open for a page's parallel requests.
# DB_POOL_SIZE=12
# DB_POOL_OVERFLOW=8
# Connections opened in the background when the app starts (0 = none).
# DB_POOL_WARM=8
# Seconds the active workspace version is kept in memory for report requests (0 = always read).
# ACTIVE_VERSION_CACHE_SECONDS=5

# Tests use DATABASE_URL_BI with temporary "app_test_*" schemas that they create and drop
# (DB_SCHEMA is set by the test suites only; the product always uses "public").
