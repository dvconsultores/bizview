# MedicalVet — local installation settings (git-ignored; never commit this file)

# ---- Database: the product's own data (users, access, audit, workspace versions, datasets) ----
DATABASE_URL_BI=
# ---- Super user (created on first start only; recovery: see docs/INSTALL.md) ----
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# ---- Branding (this customer) ----
PRODUCT_NAME=Bizview AI Powered
ORGANIZATION_NAME=

# ---- Address (local: plain HTTP on :8080 with Docker, :5173 with starter.py) ----
SITE_ADDRESS=
CADDY_ALLOWED_HOSTS=
HTTP_PORT=8090
HTTPS_PORT=9443
# internal: Cloudflare (SSL mode Full) terminates the public certificate; see docs/INSTALL.md
CADDY_TLS=internal
COOKIE_SECURE=true

# ---- Security (feature 004) ----
# private = HTTP allowed (this local setup) | internet = HTTPS required everywhere
SECURITY_PROFILE=private
# Encrypts stored credentials. BACK IT UP (password manager); losing it means re-entering
# data-source credentials and two-step sign-in.
BIZVIEW_SECRET_KEY==
# ADMIN_ALLOWED_NETWORKS=
# SOURCES_ALLOW_PRIVATE_NETWORKS=true

# ---- AI (optional, off). anthropic: set AI_API_KEY | local model: openai_compatible + AI_BASE_URL + AI_MODEL
AI_PROVIDER=anthropic
AI_API_KEY=sk-
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com/anthropic
AI_TIMEOUT_SECONDS=120

# ---- Backend ----
DOCS_ENABLED=false
LOG_LEVEL=INFO

# ---- Vibe reporting (feature 005) ----
TIMEZONE=America/Caracas


# Uncomment the following line to enable database bigger pool
# DB_POOL_SIZE=12
# DB_POOL_OVERFLOW=8
# DB_POOL_WARM=8

# Email — AWS SES SMTP
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Bizview AI Powered
# EMAIL_ALLOWED_DOMAINS=yourdomain.com

SHARE_LINKS_ENABLED=true

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=


# Off: report from a data source or an integration instead (docs/INSTALL.md 5).
DIRECT_REPORTS_BI=false


